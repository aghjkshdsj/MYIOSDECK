<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets StikDebug attach: the only way iOS allows JIT for sideloaded apps. -->
	<key>get-task-allow</key>
	<true/>
	<!-- "Memory+": raises the jetsam limit so games and the JIT pool fit. -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	<!-- Larger address space: Unity and other engines reserve multi-GB heaps up front. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
</dict>
</plist>
