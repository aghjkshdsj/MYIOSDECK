+/* MYIOSDECK: how long to wait for Valve's client to sign in and confirm the licence.
+ * Madeira's 90 s stays the default; MADEIRA_DOCK_SIGNIN_MS (90000..900000) gives a
+ * client running in an interpreter, without JIT, the time its TLS and logon take there. */
+static uint64_t signin_wait_ms(void)
+{
+    const char *s = getenv("MADEIRA_DOCK_SIGNIN_MS");
+    unsigned long v = s ? strtoul(s, NULL, 10) : 0;
+    return v >= 90000 && v <= 900000 ? v : 90000;
+}
