# Stage 4: desktop OpenGL for Windows games, from Connor Gow's (c-gow) Madeira fork
# (engine/wine/PIN): Mesa's OSMesa with the Zink driver on MoltenVK. The build scripts
# and Mesa patches are Madeira's (build/mesa-ios, build/moltenvk-ios at MADEIRA_SHA).
# Mesa 25.0.x on purpose: OSMesa was removed in 25.1. No LLVM: softpipe is the
# software driver OSMesa insists on; Zink is selected at runtime (GALLIUM_DRIVER=zink).
MESA_VERSION=25.0.7
MESA_URL=https://archive.mesa3d.org/mesa-25.0.7.tar.xz
MESA_SHA256=592272df3cf01e85e7db300c449df5061092574d099da275d19e97ef0510f8a6
MOLTENVK_REPO=https://github.com/KhronosGroup/MoltenVK.git
MOLTENVK_TAG=v1.4.2
# Mesa's Python build tools (Madeira's build.sh expects them in a venv).
MESA_PY_DEPS="meson==1.7.2 mako==1.3.10 pyyaml==6.0.2 packaging==24.2 ninja==1.11.1.4"
